# Copy this file to .env and fill in your own values.
# NEVER share your private key with anyone, including AI assistants.
# NEVER commit .env to git.

# Your wallet's private key, base58-encoded (Phantom/Solflare export format)
WALLET_PRIVATE_KEY=

# RPC endpoint. Free public RPCs are slow/rate-limited — for real use,
# get a key from Helius, QuickNode, or Triton.
RPC_URL=https://api.mainnet-beta.solana.com

# --- Risk parameters ---

# % of current SOL balance to risk per trade (e.g. 2 = 2%)
POSITION_SIZE_PCT=2

# Stop-loss and take-profit, as % move from entry price
STOP_LOSS_PCT=15
TAKE_PROFIT_PCT=30

# Breakout trigger: min 24h volume (USD) for a token to be considered
MIN_VOLUME_USD=50000

# Breakout trigger: min price increase (%) over the lookback window
BREAKOUT_PCT=10
BREAKOUT_LOOKBACK_MINUTES=15

# Max number of positions open at once
MAX_OPEN_POSITIONS=3

# Hard cap: bot will refuse to run if wallet SOL balance exceeds this.
# This is a safety rail so a misconfigured bot can't touch your whole bag.
MAX_WALLET_SOL_BALANCE=5

# Dry run — if true, logs trades instead of executing them. START HERE.
DRY_RUN=true

# --- Rug-pull screening ---
# Refuses to trade tokens flagged by RugCheck / failing on-chain
# authority checks (mint or freeze authority still active, no liquidity
# lock). Strongly recommend leaving this on.
RUG_CHECK_ENABLED=true

# --- MEV protection ---
# Routes buy transactions through Jito bundles instead of the public
# mempool, so other bots can't see and front-run your trade before it
# lands. Small tip paid to the validator; adjust for urgency.
USE_JITO_BUNDLES=true
JITO_TIP_LAMPORTS=100000

# --- Wallet security ---
# Hard caps that halt the bot if breached — catches bugs and runaway
# trading, not just bad luck.
MAX_TRADES_PER_HOUR=10
MAX_LOSS_SOL_PER_DAY=0.5

# Address of a SEPARATE wallet (one this bot never trades from) that
# profits above WORKING_BALANCE_SOL get swept to periodically. Leave
# blank to disable sweeping.
COLD_WALLET_ADDRESS=
WORKING_BALANCE_SOL=2

# --- Mode ---
# "trade" = normal automated trading. "monitor" = never trades, only
# alerts you (desktop notification + log) when a candidate passes all
# checks, so you can trade it manually. Good way to build trust in the
# logic before letting it touch your wallet.
MODE=trade

# --- Network ---
# "mainnet" or "devnet". Note: Jupiter/DexScreener don't have
# meaningful devnet liquidity, so devnet is only useful for testing
# wallet/transaction mechanics in isolation, not the trading logic.
# Use DRY_RUN=true against mainnet to test the full pipeline safely.
NETWORK=mainnet

# --- Honeypot detection ---
# Checks a token can actually be sold (not just bought) before opening
# a position. Strongly recommend leaving this on.
HONEYPOT_CHECK_ENABLED=true

# Refuse to trade if buying our position size would move pool price by
# more than this % — protects against illiquid pools you can't exit.
MAX_PRICE_IMPACT_PCT=5

# Halt after this many consecutive losing trades — catches "the
# strategy stopped working" faster than the daily SOL loss cap alone.
MAX_CONSECUTIVE_LOSSES=4

# Trades sized above this many SOL require typed confirmation in the
# terminal before executing. Set to 0 to require confirmation on
# every trade, or a very high number to effectively disable.
MANUAL_CONFIRM_THRESHOLD_SOL=0.5

# --- Encrypted key storage ---
# If true, the bot ignores WALLET_PRIVATE_KEY and instead prompts for
# a passphrase at startup to decrypt wallet.enc. Set this up first by
# running: python3 key_storage.py encrypt
USE_ENCRYPTED_KEY=false

# --- Strategy signal quality ---
# Require a breakout to hold for this many consecutive polls before
# acting on it — filters out single-poll noise/wicks.
CONFIRMATION_POLLS=2

# Pause new buys when SOL itself has dumped more than this % over the
# lookback window — meme coins are highly correlated to SOL.
SOL_CORRELATION_FILTER_ENABLED=true
SOL_DUMP_THRESHOLD_PCT=5

# --- Execution quality ---
# Scale slippage tolerance with recent volatility instead of a fixed
# 1% — tighter in calm conditions, wider in fast-moving ones.
DYNAMIC_SLIPPAGE_ENABLED=true
MIN_SLIPPAGE_BPS=50
MAX_SLIPPAGE_BPS=300

# Trailing stop: once a position is up TRAILING_ACTIVATION_PCT, switch
# from the fixed stop-loss to trailing TRAILING_STOP_PCT below the
# peak price, locking in gains instead of round-tripping to breakeven.
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=10
TRAILING_STOP_PCT=10

# Partial exit: at the take-profit target, sell PARTIAL_EXIT_PCT of
# the position and let the rest ride under the trailing stop, instead
# of exiting the whole position at once.
PARTIAL_EXIT_ENABLED=true
PARTIAL_EXIT_PCT=50

# --- Portfolio-level risk ---
# Refuse a new position if its price history correlates above this
# threshold (0-1) with an already-open position — avoids holding
# several tokens that all pump/dump together.
CORRELATION_CAP_ENABLED=true
MAX_POSITION_CORRELATION=0.7

# Scale position size down for volatile tokens, up (within bounds) for
# calm ones, instead of a flat % of wallet regardless of risk.
VOLATILITY_SIZING_ENABLED=true
MIN_SIZE_MULTIPLIER=0.4
MAX_SIZE_MULTIPLIER=1.5

# --- pump.fun integration (via PumpPortal, free, unofficial API) ---
# When enabled, listens for pump.fun tokens graduating to real AMM
# liquidity (PumpSwap/Raydium) and feeds them into the SAME screened
# trading pipeline as breakout candidates (rug check, honeypot check,
# liquidity depth all still apply). New bonding-curve launches are
# logged only — never auto-traded, since that requires a different
# execution path and carries far higher rug risk. See pumpfun.py.
PUMPFUN_ENABLED=false

# --- Per-token exposure cap ---
# Hard ceiling on how much of the wallet can go into any single token,
# regardless of what volatility sizing calculates. Position sizes above
# this get clamped down, not skipped.
MAX_TOKEN_EXPOSURE_PCT=10

# --- Stale-quote check ---
# Re-checks price right before executing. If it moved more than this %
# since the signal fired, skip the trade — the signal is stale.
STALE_QUOTE_CHECK_ENABLED=true
STALE_QUOTE_MAX_DIVERGENCE_PCT=3

# --- Alerts (both free, both optional, use either or both) ---
# Discord: Server Settings > Integrations > Webhooks > New Webhook >
# Copy Webhook URL. Treat this URL like a password.
DISCORD_WEBHOOK_URL=

# Telegram: message @BotFather on Telegram, /newbot, copy the token.
# Get your chat ID by messaging your bot then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Whale wallet tracking (ALERT ONLY, never auto-trades) ---
# Comma-separated Solana wallet addresses to watch for activity.
# There is no built-in list of "good" wallets — you supply addresses
# you've identified yourself (e.g. from DexScreener's top-traders view).
WHALE_TRACKING_ENABLED=false
WHALE_WALLETS=

# --- Leaderboard providers (all optional; use whichever you sign up for) ---
# Free-tier API keys, not paid subscriptions. Set any or all.
#   Vybe:           https://vybe.fyi/api-pricing   (global wallet leaderboard)
#   Birdeye:        https://docs.birdeye.so        (token-scoped top traders)
#   Solana Tracker: https://solanatracker.io       (global PnL leaderboard)
# Verify each works before trusting it: python3 leaderboard.py test
VYBE_API_KEY=
BIRDEYE_API_KEY=
SOLANATRACKER_API_KEY=

# Quality filters applied to leaderboard results before a wallet is
# even considered. A wallet with 3 trades and huge PnL is one lucky
# bet, not an edge.
LEADERBOARD_MIN_TRADES=20
LEADERBOARD_MIN_WIN_RATE_PCT=45
LEADERBOARD_BIRDEYE_MAX_TOKENS=5

# --- Copy-trading (score-weighted allocation) ---
# Follows a basket of wallets, sizing each by recent performance rather
# than rotating on a fail-count threshold. See copytrader.py.
COPYTRADE_ENABLED=false

# Total share of wallet that copy-trading may use, split across active
# wallets by score. Config refuses to start above 50.
COPYTRADE_ALLOCATION_PCT=20

COPYTRADE_MAX_TRACKED_WALLETS=50
COPYTRADE_MAX_ACTIVE_WALLETS=5

# Rolling window of trades used for scoring, and the minimum needed
# before a score is computed at all (below this, score is 0).
COPYTRADE_SCORE_WINDOW=20
COPYTRADE_MIN_TRADES_TO_SCORE=5

# Wallets start in paper mode. This many observed trades plus a score
# at or above PROMOTE_SCORE graduates them to real allocation.
COPYTRADE_PROBATION_MIN_TRADES=10
COPYTRADE_PROMOTE_SCORE=55

# Score floor — below this an active wallet is benched (kept on paper,
# can earn its way back). Must be lower than PROMOTE_SCORE or wallets
# would flap between tiers every cycle.
COPYTRADE_BENCH_SCORE=40

# Hard backstop: cumulative real SOL lost copying one wallet before it
# is cut regardless of score. Independent of the rolling score, which
# reacts slowly by design.
COPYTRADE_MAX_DRAWDOWN_SOL=0.3

# --- Backtest realism ---
# Flat % deducted per simulated trade to approximate real slippage and
# fees. A backtest assuming perfect fills is always too optimistic.
BACKTEST_ROUNDTRIP_COST_PCT=1.5

# --- Maintenance ---
# How long to keep compressed price history before deleting it.
BACKUP_RETENTION_DAYS=30

# --- pump.fun bonding-curve sniping (HIGH RISK — read snipe.py) ---
# Completely separate from PUMPFUN_ENABLED above. This buys brand-new
# launches BEFORE they have real liquidity, which means rug and
# honeypot screening cannot meaningfully protect you — a new mint has
# no history to screen. Most pump.fun launches fail. Off by default,
# hard-capped, and set to confirm every trade manually.
# Requires an API key from pumpportal.fun (separate from your wallet).
SNIPE_ENABLED=false
SNIPE_MAX_SOL=0.05
SNIPE_ALWAYS_CONFIRM=true
PUMPPORTAL_API_KEY=
